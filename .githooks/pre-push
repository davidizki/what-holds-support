#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

zero_sha=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  test "$local_sha" = "$zero_sha" && continue
  if test "$remote_sha" = "$zero_sha"; then
    empty_tree=$(git hash-object -t tree /dev/null)
    git diff --check "$empty_tree" "$local_sha"
  else
    git diff --check "$remote_sha" "$local_sha"
  fi
done

if test -n "$(git status --porcelain)"; then
  echo "Local verification requires a clean working tree." >&2
  echo "Commit or stash intentional changes, then push again." >&2
  exit 1
fi

echo "Checking the What Holds public website locally..."
python3 scripts/check_site.py
echo "Website checks passed; continuing push."
